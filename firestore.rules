rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isGestor() {
      return request.auth != null &&
        get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.tipo in ['gestor', 'patrao'];
    }

    // Leitura liberada para autenticados — necessário para queries de técnicos por empresa.
    match /usuarios/{userId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Leitura de todos os dados da empresa (agendamentos, técnicos, equipamentos, etc.)
    // liberada para autenticados.
    // Futuramente você pode refinar por role: request.auth.token.role == "gestor"
    match /empresas/{empresaId}/{document=**} {
      allow read: if request.auth != null;
    }

    // Escrita liberada para autenticados em todas as coleções da empresa,
    // exceto ordensServico — que tem regras próprias abaixo (trava de
    // encerramento e imutabilidade do registro fotográfico).
    match /empresas/{empresaId}/{colecao}/{resto=**} {
      allow write: if request.auth != null && colecao != 'ordensServico';
    }

    match /empresas/{empresaId}/ordensServico/{osId} {
      allow create: if request.auth != null;

      // Só permite marcar a OS como concluída se as 3 categorias de foto
      // (antes/durante/depois) já tiverem ao menos 1 registro — e a própria
      // contagem não pode ser alterada na mesma escrita que fecha a OS
      // (ela só muda pela transação de criarFotoOS/removerFotoOS).
      allow update: if request.auth != null &&
        (request.resource.data.status != 'concluido' ||
         (request.resource.data.contagemFotos == resource.data.contagemFotos &&
          resource.data.contagemFotos.antes > 0 &&
          resource.data.contagemFotos.durante > 0 &&
          resource.data.contagemFotos.depois > 0));

      allow delete: if false;

      // Fotos são um registro de auditoria: imutáveis após criadas, e só
      // podem ser apagadas (corrigidas) enquanto a OS ainda está aberta.
      match /fotos/{fotoId} {
        allow create: if request.auth != null
          && request.resource.data.autorId == request.auth.uid
          && request.resource.data.osId == osId
          && request.resource.data.categoria in ['antes', 'durante', 'depois']
          && request.resource.data.criadoEm == request.time;

        allow update: if false;

        allow delete: if request.auth != null
          && (isGestor() || resource.data.autorId == request.auth.uid)
          && get(/databases/$(database)/documents/empresas/$(empresaId)/ordensServico/$(osId)).data.status == 'em_andamento';
      }
    }
  }
}
